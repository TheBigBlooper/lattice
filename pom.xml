<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.lattice</groupId>
  <artifactId>lattice-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Lattice</name>
  <description>Java 21 / Vert.x 5 microservice platform - parent aggregator POM.</description>

  <modules>
    <module>platform/lattice-contract</module>
    <module>platform/lattice-common</module>
    <module>services/orders</module>
    <module>services/inventory</module>
    <module>services/mesh-gateway</module>
  </modules>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Stack versions - managed centrally, referenced by child modules without a version. -->
    <vertx.version>5.1.5</vertx.version>
    <junit.version>5.14.0</junit.version>
    <testcontainers.version>2.0.5</testcontainers.version>
    <!-- Elasticsearch Java client + server image tag (locked #34). One property drives the
         client dependency here and the Testcontainers/deploy image tag. -->
    <elasticsearch.version>8.19.19</elasticsearch.version>
    <!-- Jackson: pinned to the version Vert.x 5.1.5 manages (vertx-dependencies jackson2.version)
         so the Elasticsearch client's Jackson converges on the one engine already on the tree. -->
    <jackson.version>2.21.5</jackson.version>
    <!-- Logging: SLF4J API is the one logging facade; Logback is the binding. slf4j.version is
         pinned to the version logback-classic pulls, so the explicitly declared slf4j-api and the
         one Logback needs converge on a single version (enforcer dependencyConvergence stays green). -->
    <slf4j.version>2.0.17</slf4j.version>
    <logback.version>1.5.34</logback.version>
    <!-- Pinned above the 1.29.0 that elasticsearch-java drags in transitively (that version carries
         GHSA-rcgg-9c38-7xpx, which the supply-chain gate blocks on). A runtime tracing API we do not
         configure; managed here so the whole reactor converges on one version. -->
    <opentelemetry.version>1.62.0</opentelemetry.version>

    <!-- Build plugin versions. -->
    <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
    <maven-failsafe-plugin.version>3.5.6</maven-failsafe-plugin.version>
    <maven-shade-plugin.version>3.6.1</maven-shade-plugin.version>

    <!-- Quality-gate tooling. These fast gates run in verify (pre-push hook); the supply-chain
         scan is OSV-Scanner, a pinned binary in CI (not a Maven plugin), so it has no version here. -->
    <spotless.version>3.8.0</spotless.version>
    <palantir-java-format.version>2.96.0</palantir-java-format.version>
    <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
    <checkstyle.version>13.8.0</checkstyle.version>
    <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>
    <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
    <spotbugs-maven-plugin.version>4.10.3.0</spotbugs-maven-plugin.version>
    <spotbugs.version>4.10.3</spotbugs.version>
    <findsecbugs.version>1.14.0</findsecbugs.version>
    <cyclonedx-maven-plugin.version>2.9.2</cyclonedx-maven-plugin.version>

    <!-- Coverage floors enforced by JaCoCo (build fails below). -->
    <coverage.line.minimum>0.90</coverage.line.minimum>
    <coverage.branch.minimum>0.80</coverage.branch.minimum>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Vert.x 5 stack - manages every io.vertx artifact (core, web, junit5, ...). -->
      <dependency>
        <groupId>io.vertx</groupId>
        <artifactId>vertx-dependencies</artifactId>
        <version>${vertx.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- JUnit 5 (Jupiter) - the test programming model + engine. -->
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Testcontainers - real Elasticsearch + Artemis in integration tests. -->
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Jackson - one engine across the tree. Pinned to Vert.x's managed version so the
           Elasticsearch client's transitive Jackson converges instead of forking a second version. -->
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Elasticsearch official typed Java client (co.elastic.clients). -->
      <dependency>
        <groupId>co.elastic.clients</groupId>
        <artifactId>elasticsearch-java</artifactId>
        <version>${elasticsearch.version}</version>
      </dependency>
      <!-- Convergence pins for the Elasticsearch rest-client transitive tree. Its Apache HttpComponents,
           commons-codec, and jakarta.json versions diverge internally; pin one coherent version of each so
           the enforcer dependencyConvergence gate passes (these align versions, they do not add engines). -->
      <dependency>
        <groupId>org.apache.httpcomponents</groupId>
        <artifactId>httpclient</artifactId>
        <version>4.5.14</version>
      </dependency>
      <dependency>
        <groupId>org.apache.httpcomponents</groupId>
        <artifactId>httpcore</artifactId>
        <version>4.4.16</version>
      </dependency>
      <dependency>
        <groupId>org.apache.httpcomponents</groupId>
        <artifactId>httpcore-nio</artifactId>
        <version>4.4.16</version>
      </dependency>
      <dependency>
        <groupId>org.apache.httpcomponents</groupId>
        <artifactId>httpasyncclient</artifactId>
        <version>4.1.5</version>
      </dependency>
      <dependency>
        <groupId>commons-codec</groupId>
        <artifactId>commons-codec</artifactId>
        <version>1.15</version>
      </dependency>
      <dependency>
        <groupId>jakarta.json</groupId>
        <artifactId>jakarta.json-api</artifactId>
        <version>2.1.3</version>
      </dependency>
      <!-- Logging facade + binding. Versioned here; modules declare them without a version and
           pick the scope they need (slf4j-api compile where a module logs; logback-classic as the
           runtime binding in a service, or test-scoped where only tests emit). -->
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
      <dependency>
        <groupId>ch.qos.logback</groupId>
        <artifactId>logback-classic</artifactId>
        <version>${logback.version}</version>
      </dependency>
      <!-- JCL-to-SLF4J bridge: re-implements the commons-logging API and routes it to SLF4J, so the
           Elasticsearch REST client's Apache-HTTP transport (which logs via commons-logging) joins the
           one Logback pipeline (locked #39) instead of printing to stderr. Versioned in lockstep with
           slf4j-api. Wherever this is on the classpath, the transitive commons-logging must be excluded
           so the bridge (not the real JCL) provides the org.apache.commons.logging classes. -->
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>jcl-over-slf4j</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
      <!-- OpenTelemetry BOM: elasticsearch-java pulls opentelemetry-api (and -context) transitively
           at a version with a known advisory. Importing the BOM lifts the whole family together, so
           api and context cannot drift apart the way pinning a single artifact would risk. -->
      <dependency>
        <groupId>io.opentelemetry</groupId>
        <artifactId>opentelemetry-bom</artifactId>
        <version>${opentelemetry.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
        </plugin>
        <!-- Surefire runs *Test (unit); Failsafe runs *IT (integration) in the verify phase.
             Both route Vert.x's own logging through the SLF4J delegate so there is one log pipeline
             (Vert.x -> SLF4J -> Logback) in tests, matching what MainVerticle sets for the app. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
          <configuration>
            <systemPropertyVariables>
              <vertx.logger-delegate-factory-class-name>io.vertx.core.logging.SLF4JLogDelegateFactory</vertx.logger-delegate-factory-class-name>
            </systemPropertyVariables>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${maven-failsafe-plugin.version}</version>
          <configuration>
            <systemPropertyVariables>
              <vertx.logger-delegate-factory-class-name>io.vertx.core.logging.SLF4JLogDelegateFactory</vertx.logger-delegate-factory-class-name>
            </systemPropertyVariables>
          </configuration>
          <executions>
            <execution>
              <goals>
                <goal>integration-test</goal>
                <goal>verify</goal>
              </goals>
            </execution>
          </executions>
        </plugin>

        <!-- IDE-only metadata (m2e). Not a real plugin and never run by Maven; it lives in
             pluginManagement so the CLI ignores it. It tells the Eclipse/VS Code Maven
             integration NOT to run the quality-gate goals during incremental IDE builds
             (they still run on `./mvnw verify`, the pre-push hook, and CI). -->
        <plugin>
          <groupId>org.eclipse.m2e</groupId>
          <artifactId>lifecycle-mapping</artifactId>
          <version>1.0.0</version>
          <configuration>
            <lifecycleMappingMetadata>
              <pluginExecutions>
                <pluginExecution>
                  <pluginExecutionFilter>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <versionRange>[0,)</versionRange>
                    <goals>
                      <goal>check</goal>
                    </goals>
                  </pluginExecutionFilter>
                  <action>
                    <ignore />
                  </action>
                </pluginExecution>
                <pluginExecution>
                  <pluginExecutionFilter>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-checkstyle-plugin</artifactId>
                    <versionRange>[0,)</versionRange>
                    <goals>
                      <goal>check</goal>
                    </goals>
                  </pluginExecutionFilter>
                  <action>
                    <ignore />
                  </action>
                </pluginExecution>
                <pluginExecution>
                  <pluginExecutionFilter>
                    <groupId>com.github.spotbugs</groupId>
                    <artifactId>spotbugs-maven-plugin</artifactId>
                    <versionRange>[0,)</versionRange>
                    <goals>
                      <goal>check</goal>
                    </goals>
                  </pluginExecutionFilter>
                  <action>
                    <ignore />
                  </action>
                </pluginExecution>
                <pluginExecution>
                  <pluginExecutionFilter>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <versionRange>[0,)</versionRange>
                    <goals>
                      <goal>enforce</goal>
                    </goals>
                  </pluginExecutionFilter>
                  <action>
                    <ignore />
                  </action>
                </pluginExecution>
                <pluginExecution>
                  <pluginExecutionFilter>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <versionRange>[0,)</versionRange>
                    <goals>
                      <goal>prepare-agent</goal>
                      <goal>report</goal>
                      <goal>check</goal>
                    </goals>
                  </pluginExecutionFilter>
                  <action>
                    <ignore />
                  </action>
                </pluginExecution>
              </pluginExecutions>
            </lifecycleMappingMetadata>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- Formatting gate: Palantir Java Format. `spotless:check` fails on drift; `spotless:apply` fixes. -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <palantirJavaFormat>
              <version>${palantir-java-format.version}</version>
            </palantirJavaFormat>
            <removeUnusedImports />
          </java>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Style gate: non-formatting rules only (Javadoc on public API, naming, the em-dash ban). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>${maven-checkstyle-plugin.version}</version>
        <dependencies>
          <dependency>
            <groupId>com.puppycrawl.tools</groupId>
            <artifactId>checkstyle</artifactId>
            <version>${checkstyle.version}</version>
          </dependency>
        </dependencies>
        <configuration>
          <configLocation>${maven.multiModuleProjectDirectory}/config/checkstyle/checkstyle.xml</configLocation>
          <includeTestSourceDirectory>false</includeTestSourceDirectory>
          <failOnViolation>true</failOnViolation>
          <violationSeverity>error</violationSeverity>
        </configuration>
        <executions>
          <execution>
            <id>checkstyle-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Coverage gate: line 90% / branch 80% (build fails below). -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco-maven-plugin.version}</version>
        <executions>
          <execution>
            <id>jacoco-prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <!-- Integration tests count toward coverage too. The agent appends to the SAME exec file the
               unit run wrote, so jacoco-check (bound to verify, after integration-test) measures both.
               Without this, a Testcontainers suite could exercise a whole code path and still leave it
               reported as uncovered, which pushes a module toward tests written to move the number
               rather than to pin behavior. -->
          <execution>
            <id>jacoco-prepare-agent-integration</id>
            <goals>
              <goal>prepare-agent-integration</goal>
            </goals>
            <configuration>
              <destFile>${project.build.directory}/jacoco.exec</destFile>
              <!-- Explicitly append: this agent starts against the file the unit run already wrote, and
                   without it the integration JVM truncates that data instead of adding to it, which
                   quietly LOWERS the measured coverage rather than completing it. -->
              <append>true</append>
            </configuration>
          </execution>
          <execution>
            <id>jacoco-report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <!-- Re-report after the integration tests so the HTML matches what check measured. -->
          <execution>
            <id>jacoco-report-integration</id>
            <phase>post-integration-test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>jacoco-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <excludes>
                <exclude>**/generated/**</exclude>
                <exclude>**/MainVerticle.*</exclude>
              </excludes>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${coverage.line.minimum}</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${coverage.branch.minimum}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Dependency hygiene: pin Java 21, converge versions, ban duplicate engines (one-engine rule). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven-enforcer-plugin.version}</version>
        <executions>
          <execution>
            <id>enforce-rules</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,22)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                </requireMavenVersion>
                <banDuplicatePomDependencyVersions />
                <dependencyConvergence />
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Static bug + security analysis. -->
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <version>${spotbugs-maven-plugin.version}</version>
        <dependencies>
          <dependency>
            <groupId>com.github.spotbugs</groupId>
            <artifactId>spotbugs</artifactId>
            <version>${spotbugs.version}</version>
          </dependency>
        </dependencies>
        <configuration>
          <effort>Max</effort>
          <threshold>Medium</threshold>
          <includeTests>false</includeTests>
          <!-- Narrow, documented false-positive exclusions only (see the file's header comment). -->
          <excludeFilterFile>${maven.multiModuleProjectDirectory}/config/spotbugs/spotbugs-exclude.xml</excludeFilterFile>
          <plugins>
            <plugin>
              <groupId>com.h3xstream.findsecbugs</groupId>
              <artifactId>findsecbugs-plugin</artifactId>
              <version>${findsecbugs.version}</version>
            </plugin>
          </plugins>
        </configuration>
        <executions>
          <execution>
            <id>spotbugs-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Failsafe runs *IT integration suites in the integration-test/verify phases reactor-wide
           (version + executions managed in pluginManagement). Active here so every module with
           Testcontainers *IT tests runs them without re-declaring the plugin. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>

      <!-- CycloneDX SBOM: the input to the OSV-Scanner supply-chain gate in CI. Maven does the
           resolution here because only it can resolve the reactor's own modules (lattice-common,
           lattice-contract are unpublished SNAPSHOTs); a scanner resolving remotely cannot, and
           silently drops the whole graph. makeAggregateBom emits ONE bom.json at the build root
           covering every module's full transitive closure, so the gate scans exactly the tree that
           was just built + verified. -->
      <plugin>
        <groupId>org.cyclonedx</groupId>
        <artifactId>cyclonedx-maven-plugin</artifactId>
        <version>${cyclonedx-maven-plugin.version}</version>
        <!-- Aggregate is a whole-reactor goal: run once from the root, never per module. -->
        <inherited>false</inherited>
        <configuration>
          <outputFormat>json</outputFormat>
          <outputName>bom</outputName>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>makeAggregateBom</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <!-- No security-scan profile: the supply-chain gate is OSV-Scanner, run as its own CI job from a
       pinned binary (.github/workflows/ci.yml), not a Maven plugin. Maven's only role is producing
       the CycloneDX SBOM the scanner reads (the cyclonedx-maven-plugin above), because Maven is the
       only thing that can resolve this reactor's own unpublished SNAPSHOT modules. -->
</project>
