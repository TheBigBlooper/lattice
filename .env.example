# Lattice - example environment variables.
# Copy to .env for local runs; .env is never committed. Every service reads config
# through the shared config loader in lattice-common, not scattered System.getenv calls.
# Full per-service + per-environment matrix: docs/reference/integrations.md

# --- Service HTTP (per-service API + health/readiness server) ---
HTTP_PORT=8080

# --- Elasticsearch (datastore; one data model per cluster) ---
ELASTICSEARCH_URL=http://localhost:9200
# ELASTICSEARCH_USERNAME=          # unset locally (security relaxed); set per environment
# ELASTICSEARCH_PASSWORD=          # secret; set per environment

# --- Apache Artemis (mesh broker; cluster-to-cluster transport) ---
# Read by the mesh-gateway ONLY: it is this cluster's sole mesh participant (locked #42),
# so orders, inventory, and any later service never connect to a broker.
# Single-valued by design (locked #44): every baseline runs its own broker and addresses
# only that one. Peer brokers are reached by broker-to-broker federation, configured in
# deploy/docker/artemis/, never by pointing a service at someone else's broker.
ARTEMIS_URL=tcp://localhost:61616
ARTEMIS_USER=artemis
ARTEMIS_PASSWORD=artemis

# --- Broker identity (read by the BROKER, not by any service) ---
# Unlocks this baseline's keystore and the shared truststore. Peer brokers authenticate to each
# other with a per-baseline X.509 certificate over mutual TLS (locked #50), so there is no longer a
# shared federation password: the certificate IS the credential.
#
# Generate the material before the first `up` - it is git-ignored, never committed:
#   ./deploy/docker/artemis/tls/issue-certs.sh
#
# Local development only for this default. In a deployed environment the keystore is a Kubernetes
# Secret and this value comes from the cluster's secret manager - see deploy/k8s/artemis-tls.yaml.
LATTICE_TLS_PASSWORD=lattice

# --- Mesh identity + discovery (read by the mesh-gateway service) ---
# This cluster's identity, advertised to peers on every announcement.
CLUSTER_ID=hub-local
REGION=local
BASELINE_VERSION=0.1.0-SNAPSHOT
# Where peers reach this cluster. CONSOLE_URL is the redirect target ("go to this
# baseline"); API_BASE_URL is what a peer's unified view live-pulls for detail.
CONSOLE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080/api/v1
# The services whose /readiness is polled to compute this cluster's health rollup
# (all UP -> ready, some UP -> degraded, none UP -> down). Empty means nothing is
# watched, which is logged loudly at startup.
CLUSTER_SERVICES=orders=http://localhost:8080,inventory=http://localhost:8081
# Announce cadence + peer liveness. The heartbeat is the liveness signal; a peer
# unheard for PEER_TTL shows as UNREACHABLE (retained, not removed).
HEARTBEAT_INTERVAL=10s
PEER_TTL=30s

# --- Keycloak (per-baseline identity; locked #38, #48) ---
# This baseline's OWN Keycloak. Single-valued by design: a service never addresses a peer's
# Keycloak, for the same reason it never addresses a peer's broker - identity belongs to the
# baseline that owns the data, so a redirect to a peer authenticates against THAT peer's realm.
# Every service validates a bearer token on every /api/v1 operation against this realm's
# published signing keys; /health and /readiness stay open, since a probe cannot carry a token.
# A service that starts with these unset refuses to start rather than serve /api/v1 unprotected.
KEYCLOAK_URL=http://localhost:8083
KEYCLOAK_REALM=lattice
# The public client the status console authenticates as (authorization code + PKCE). Read by the
# console only: a service is bearer-only and never initiates a login flow.
KEYCLOAK_CLIENT_ID=lattice-console
# The local demo operator seeded by the committed realm import, for obtaining a token during QA.
# Local development only - a deployed environment manages its own users.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- Status console (read by the console at BUILD time, not run time) ---
# Vite inlines every VITE_* value when the image is built, so a variable absent at build time is
# absent in the image however the container is later configured. All of these point at THIS
# baseline: the console never addresses a peer's API or a peer's Keycloak.
VITE_API_BASE_URL=http://localhost:8082/api/v1
VITE_CLUSTER_ID=hub-local
VITE_KEYCLOAK_URL=http://localhost:8083
VITE_KEYCLOAK_REALM=lattice
VITE_KEYCLOAK_CLIENT_ID=lattice-console

# --- Cross-origin access (read by every service via BaseVerticle) ---
# The status console's browser live-pulls each PEER's API cross-origin, so every
# service a peer console reads must allow it. Comma-separated origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Kubernetes (orchestration) ---
# KUBECONFIG=                      # path to the target cluster's kubeconfig; never committed
K8S_NAMESPACE=lattice

# --- Container registry (provider TBD - locked_decisions.md P7) ---
# IMAGE_REGISTRY=                  # registry host / prefix; set when the registry lands
# IMAGE_REGISTRY_USER=             # secret (CI)
# IMAGE_REGISTRY_TOKEN=            # secret (CI)
