# Lattice - example environment variables.
# Copy to .env for local runs; .env is never committed. Every service reads config
# through the shared config loader in lattice-common, not scattered System.getenv calls.
# Full per-service + per-environment matrix: docs/reference/integrations.md

# --- Service HTTP (per-service API + health/readiness server) ---
HTTP_PORT=8080

# --- Elasticsearch (datastore; one data model per cluster) ---
ELASTICSEARCH_URL=http://localhost:9200
# ELASTICSEARCH_USERNAME=          # unset locally (security relaxed); set per environment
# ELASTICSEARCH_PASSWORD=          # secret; set per environment

# --- Apache Artemis (mesh broker; cluster-to-cluster transport) ---
ARTEMIS_URL=tcp://localhost:61616
ARTEMIS_USER=artemis
ARTEMIS_PASSWORD=artemis

# --- Kubernetes (orchestration) ---
# KUBECONFIG=                      # path to the target cluster's kubeconfig; never committed
K8S_NAMESPACE=lattice

# --- Container registry (provider TBD - locked_decisions.md P7) ---
# IMAGE_REGISTRY=                  # registry host / prefix; set when the registry lands
# IMAGE_REGISTRY_USER=             # secret (CI)
# IMAGE_REGISTRY_TOKEN=            # secret (CI)
