# Generated by issue-certs.sh. None of it belongs in git: ca.key and every baseline keystore hold
# real private keys, and a development authority committed to a repository is a private key in a
# public place. Regenerate with ./issue-certs.sh - it is deterministic in layout, not in key material.
ca/
*.p12
*.crt
*.key
*.csr
*.pem
*.srl
foreign/

# Artemis writes a broker instance layout into its working directory. Running the image with this
# directory mounted as the working dir - which inspecting a certificate does - drops these here.
# They are not certificate material and are not ours to keep.
bin/
etc/
data/
log/
tmp/
