<?xml version='1.0'?>
<!--
  Outbound connectors for the hub-local baseline.

  This baseline names no peer, so the only entry is "self" - how a PEER reaches this broker, not how
  this broker reaches itself. It is unused until this baseline declares a downstream of its own, but
  it is not optional: the schema rejects an empty <connectors>, and every baseline documenting its own
  reachable address here is what makes federation.xml the only file that differs on a join.

  It carries the full mutual-TLS parameters for the same reason it exists at all: this string is
  handed to a PEER by a downstream command and dialled verbatim there. A self connector without the
  TLS settings would have the peer arrive at the federation acceptor speaking plain TCP and be
  dropped in the handshake - a failure that reads as the peer's fault and is not.

  Port 61617, not 61616: 61616 is this baseline's own services, authenticating with a password.
  Peers use the mutual-TLS acceptor and present a certificate instead (locked #50).
-->
<connectors xmlns="urn:activemq:core">
   <connector name="hub-local-self">tcp://artemis:61617?sslEnabled=true;keyStorePath=${artemis.instance}/tls/keystore.p12;keyStoreType=PKCS12;keyStorePassword=${LATTICE_TLS_PASSWORD};trustStorePath=${artemis.instance}/tls/truststore.p12;trustStoreType=PKCS12;trustStorePassword=${LATTICE_TLS_PASSWORD}</connector>
</connectors>
