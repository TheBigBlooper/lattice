{{- /*
  THIS FILE IS A TEMPLATE, not the JSON that ships. It is rendered with `tpl` by
  templates/realm-configmap.yaml, so a reviewer reads this rather than the document Keycloak imports.
  That is the accepted cost of Decision 7: what it buys is that the ports and the realm CANNOT
  disagree.

  They used to. This file pinned every console port and all nine service ports for all three
  baselines, and nothing in the chart said so - so a console served anywhere else was refused with
  "Invalid parameter: redirect_uri", which is a Keycloak error message pointing at a chart value.
  Every baseline also carried every OTHER baseline's addresses, which is a redirect allow-list far
  wider than any one baseline needs.

  Only the URL LISTS are computed. Roles, groups, users and client flags stay static JSON below,
  because they are genuinely fixed and are more reviewable as JSON than as a template.
*/ -}}
{{- $g := .Values.global -}}
{{- /* The console's own address, plus anything the environment adds - a developer's Vite dev
       server, typically. `webOrigins` is the origin; `redirectUris` is the same with a path glob. */ -}}
{{- $consoleOrigins := concat (list $g.baseline.consoleUrl) ($g.keycloak.extraConsoleOrigins | default list) -}}
{{- $consoleRedirects := list -}}
{{- range $consoleOrigins -}}
{{- $consoleRedirects = append $consoleRedirects (printf "%s/*" .) -}}
{{- end -}}
{{- /* The docs page is served BY each service, so its redirect is per service address a browser can
       reach. Empty means no docs client redirects at all, which is correct for a deployment that
       does not expose the services to a browser - and API_DOCS_ENABLED is false there anyway. */ -}}
{{- $docsOrigins := list -}}
{{- $docsRedirects := list -}}
{{- range $name, $url := ($g.baseline.serviceUrls | default dict) -}}
{{- $docsOrigins = append $docsOrigins $url -}}
{{- $docsRedirects = append $docsRedirects (printf "%s/docs/oauth2-redirect.html" $url) -}}
{{- end -}}
{
  "realm": {{ $g.keycloak.realm | quote }},
  "enabled": true,
  "displayName": "Lattice",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      {
        "name": "viewer",
        "description": "Reads every GET under /api/v1."
      },
      {
        "name": "operator",
        "description": "Reads everything a viewer can, plus the writes: create order, set stock, create reservation.",
        "composite": true,
        "composites": {
          "realm": [
            "viewer"
          ]
        }
      }
    ]
  },
  "groups": [
    {
      "name": "viewers",
      "realmRoles": [
        "viewer"
      ]
    },
    {
      "name": "operators",
      "realmRoles": [
        "operator"
      ]
    }
  ],
  "clients": [
    {
      "clientId": "lattice-console",
      "name": "Lattice status console",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "redirectUris": {{ $consoleRedirects | toJson }},
      "webOrigins": {{ $consoleOrigins | toJson }}
    },
    {
      "clientId": "lattice-docs",
      "name": "Lattice API docs (Swagger UI)",
      "description": "The Swagger UI page each service serves at /docs. Public client, authorization code with PKCE, exactly like the console - kept separate from lattice-console so the console redirect URIs stay narrow.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": {{ $docsRedirects | toJson }},
      "webOrigins": {{ $docsOrigins | toJson }},
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      }
    }
  ],
  "users": [
    {
      "username": "operator",
      "enabled": true,
      "emailVerified": true,
      "email": "operator@lattice.invalid",
      "requiredActions": [],
      "firstName": "Local",
      "lastName": "Operator",
      "credentials": [
        {
          "type": "password",
          "value": "operator",
          "temporary": false
        }
      ],
      "groups": [
        "/operators"
      ]
    },
    {
      "username": "viewer",
      "enabled": true,
      "emailVerified": true,
      "email": "viewer@lattice.invalid",
      "requiredActions": [],
      "firstName": "Local",
      "lastName": "Viewer",
      "credentials": [
        {
          "type": "password",
          "value": "viewer",
          "temporary": false
        }
      ],
      "groups": [
        "/viewers"
      ]
    }
  ]
}
